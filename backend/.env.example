# 随行管家 · 环境变量模板（复制到 agent/.env 后填写）
# 注意：agent/.env 已在 .gitignore 中，不要提交。

# ---- 模型（主链路）----
DASHSCOPE_API_KEY=sk-xxxxxxxx
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 向量库（主链路：知识检索 + 语义缓存）----
MILVUS_URI=https://in03-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_API_KEY=db_xxxx:xxxx
MILVUS_POLICY_COLLECTION=hotel_policy_docs
QA_CACHE_COLLECTION=qa_semantic_cache

# ---- 业务库（主链路）----
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/hotel_service

# ---- 缓存策略 ----
CACHE_SIMILARITY_MODE=similarity
SEMANTIC_CACHE_THRESHOLD=0.85
POLICY_VERSION=HOTEL-2026.1

# ---- 可选/关闭的依赖 ----
# REDIS_URL=redis://localhost:6379/0   # 不配置则短期记忆走 PostgreSQL
ENABLE_NEO4J=false                     # 图谱默认关闭（03 变动 5）

# ---- 业务参数 ----
DEFAULT_STORE_ID=HT001
SLA_SERVICE_MINUTES=20
SLA_MAINTENANCE_MINUTES=30
SLA_SAFETY_MINUTES=10
STAY_GRACE_HOURS=2
HOP_MAX=2
ROUTE_CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO
